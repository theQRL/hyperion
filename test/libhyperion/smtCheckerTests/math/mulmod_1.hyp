contract C {
	function f() public pure {
		assert(mulmod(2**256 - 1, 2, 14) == 2);
		uint256 y = 0;
		uint x = mulmod(2**256 - 1, 10, y);
		assert(x == 1);
	}
	function g(uint256 x, uint256 y, uint256 k) public pure returns (uint) {
		return mulmod(x, y, k);
	}
}
