contract State {
	C c;
	constructor(C _c) {
		c = _c;
	}
	function f() public view returns (uint256) {
		return c.g();
	}
}

contract C {
	address owner;
	uint256 y;
	State s;

	constructor() {
		owner = msg.sender;
		s = new State(this);
	}

	function f() public view {
		address prevOwner = owner;
		uint256 z = s.f();
		assert(z == y);
		assert(prevOwner == owner);
	}

	function g() public view returns (uint256) {
		return y;
	}
}
