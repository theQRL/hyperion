contract C {
    function literals(bytes memory sig, bytes memory key, bytes memory ctx) public pure {
        assert(mldsa87verify(bytes64("a"), sig, key, ctx) == mldsa87verify(bytes64(bytes1("a")), sig, key, ctx));
        assert(mldsa87verify(bytes64(hex"80ff"), sig, key, ctx) == mldsa87verify(bytes64(bytes2(hex"80ff")), sig, key, ctx));
    }

    function widened32(bytes32 digest, bytes memory sig, bytes memory key, bytes memory ctx) public pure {
        // bytes64(bytesN) keeps the value left-aligned, bytes64(uint512) right-aligned.
        assert(mldsa87verify(bytes64(digest), sig, key, ctx) == mldsa87verify(bytes64(uint512(uint256(digest)) << 256), sig, key, ctx));
    }

    function differentDigests(bytes memory sig, bytes memory key, bytes memory ctx) public pure {
        bool first = mldsa87verify(bytes64(bytes1(0x42)), sig, key, ctx);
        bool last = mldsa87verify(bytes64(uint512(0x42)), sig, key, ctx);
        // These put 0x42 at opposite ends of the digest, so equality is not guaranteed.
        assert(first == last);
    }
}
