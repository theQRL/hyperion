contract C {
    function valueRange() public payable {
        assert(msg.value <= type(uint).max);
        assert(msg.value <= type(uint256).max); // should fail
    }
    function balanceRange(address a) public view {
        assert(a.balance <= type(uint).max);
        assert(a.balance <= type(uint256).max); // should fail
    }
    function receiveWide() public payable {
        require(msg.value > type(uint256).max);
        assert(address(this).balance >= msg.value);
        assert(false); // must remain reachable with a wide message value
    }
    function transferWide(address payable a) public {
        require(a != address(this));
        require(address(this).balance == (uint(1) << 300) + 10);
        a.transfer(uint(1) << 300);
        assert(address(this).balance == 10);
        assert(false); // must remain reachable with a wide balance
    }
}
