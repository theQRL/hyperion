contract C {
    modifier repeat(bool twice) {
        if (twice) _;
        _;
    }

    function f(bool twice) public repeat(twice) returns (uint256 r) {
        r += 1;
    }
}
// ====
// compileViaYul: true
// compileViaYulReason: IR resets return variables on each modifier invocation; legacy shares their stack slots.
// ----
// f(bool): false -> 1
// f(bool): true -> 1
