contract C {
    uint public state = 0;
    constructor(uint _state) payable {
        state = _state;
    }
    function balance() public payable returns (uint) {
        return address(this).balance;
    }
    function update(uint _state) public {
        state = _state;
    }
}
// ----
// constructor(), 2 planck: 3 ->
// gas irOptimized: 104958
// gas legacy: 148830
// gas legacyOptimized: 107245
// state() -> 3
// balance() -> 2
// balance -> 2
// update(uint512): 4
// state() -> 4
