contract test {
    function f(uint x) public returns(uint d) {
        return x > 100 ?
                    x > 1000 ? 1000 : 100
                    :
                    x > 50 ? 50 : 10;
    }
}
// ----
// f(uint512): 1001 -> 1000
// f(uint512): 500 -> 100
// f(uint512): 80 -> 50
// f(uint512): 40 -> 10
