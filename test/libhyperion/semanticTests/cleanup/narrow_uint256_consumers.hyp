// Adapted from the paired CIPH-HYPERION-9 audit reproducers; both pipelines share these expectations.
// Inline assembly explicitly cleans narrow values, as required by docs/assembly.rst.
contract C {
    receive() external payable {}

    function am(uint x) public pure returns (uint) { return addmod(uint256(x), 7, 10); }
    function mm(uint x) public pure returns (uint) { return mulmod(uint256(x), 3, 10); }
    function amVar(uint x) public pure returns (uint) { uint256 y = uint256(x); return addmod(y, 7, 10); }
    function amParam(uint x) public pure returns (uint) { return addParam(uint256(x)); }
    function addParam(uint256 y) internal pure returns (uint) { return addmod(y, 7, 10); }
    function asmRead(uint x) public pure returns (uint r) { uint256 y = uint256(x); assembly { r := and(y, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff) } }
    function asmStore(uint x) public pure returns (bytes memory b) {
        uint256 y = uint256(x);
        b = new bytes(64);
        assembly { mstore(add(b, 64), and(y, 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)) }
    }
    function newLen(uint x) public pure returns (uint) { return new bytes(uint256(x)).length; }
    function slice(bytes calldata d, uint s, uint e) external pure returns (bytes memory) { return d[uint256(s):uint256(e)]; }
    function index(uint x) public pure returns (uint) {
        uint[2] memory a = [uint(11), 22];
        return a[uint256(x)];
    }
    function callValue(uint v) public returns (bool ok) { (ok, ) = address(this).call{value: uint256(v)}(""); }
    function xfer(uint v) public { payable(address(this)).transfer(uint256(v)); }
    function gasOpt(uint g) public returns (bool ok) { (ok, ) = address(this).call{gas: uint256(g)}(""); }
}
