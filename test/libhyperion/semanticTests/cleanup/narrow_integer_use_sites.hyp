// Legacy may defer cleanup after narrowing or unchecked arithmetic. Each consumer must
// nevertheless observe the declared width. These expectations also apply to the IR pipeline.
contract C {
    mapping(uint256 => uint) values;
    uint256 stored;
    event Observed(uint256 indexed key, uint256 value);

    function unsignedUses(uint x, uint y) external pure returns (uint256, uint256, uint256, uint256, bool) {
        uint256 a = uint256(x);
        uint256 b = uint256(y);
        unchecked { return (a / b, a % b, a >> b, a << b, a == 5); }
    }
    function signedUses(uint x, uint y) external pure returns (int256, int256, int256, bool) {
        int256 a = int256(int(x));
        int256 b = int256(int(y));
        unchecked { return (a / b, a % b, a >> uint256(b), a < 0); }
    }
    function remainder(uint x, uint y) external pure returns (uint256) {
        unchecked { return uint256(x) % uint256(y); }
    }
    function powers(uint x, uint y) external pure returns (uint256, uint8) {
        unchecked { return (uint256(x) ** uint256(y), uint8(0) ** uint8(y)); }
    }
    function wrappedUses(uint x) external pure returns (uint256, uint256, uint256, uint256, bool) {
        uint256 a = uint256(x);
        unchecked {
            a += 1;
            return (a / 2, a % 3, a >> 1, uint256(0) ** a, a == 0);
        }
    }
    function wrappedSignedUses(uint x) external pure returns (int256, int256, int256, bool) {
        int256 a = int256(int(x));
        unchecked {
            a += 1;
            return (a / 2, a % 3, a >> 1, a < 0);
        }
    }
    function compound(uint x) external pure returns (uint256, uint256, uint256, uint256) {
        uint256 a = uint256(x);
        uint256 b = uint256(x);
        uint256 c = uint256(x);
        uint256 d = uint256(x);
        unchecked { a /= 3; b %= 3; c >>= 1; d <<= 1; }
        return (a, b, c, d);
    }
    function signedCompound(uint x) external pure returns (int256, int256, int256) {
        int256 a = int256(int(x));
        int256 b = int256(int(x));
        int256 c = int256(int(x));
        unchecked { a /= 2; b %= 2; c >>= 1; }
        return (a, b, c);
    }
    function smallUses(uint x, uint y) external pure returns (uint8, uint8, uint8, uint8) {
        uint8 a = uint8(x);
        uint8 b = uint8(y);
        unchecked { return (a / b, a % b, a >> b, a ** b); }
    }
    function largeUses(uint x, uint y) external pure returns (uint504, uint504, uint504, uint504) {
        uint504 a = uint504(x);
        uint504 b = uint504(y);
        unchecked { return (a / b, a % b, a >> b, a ** b); }
    }
    function edgeWidths(uint x) external pure returns (uint8, uint504, bool, bool) {
        uint8 a = uint8(x);
        uint504 b = uint504(x);
        unchecked { ++a; ++b; return (a / 2, b / 2, a == 0, b == 0); }
    }
    function pass(uint256 x) internal pure returns (uint256) { return x; }
    function echo(uint256 x) external pure returns (uint256) { return x; }
    function sameWidthFlow(uint x) external returns (uint, uint256, uint256, uint256, bool) {
        uint256 y = pass(uint256(x));
        values[y] = 42;
        stored = y;
        uint256[1] memory m = [y];
        emit Observed(y, y);
        return (
            values[5], stored, m[0], this.echo(y),
            keccak256(abi.encodePacked(y)) == keccak256(abi.encodePacked(uint256(5)))
        );
    }
}
