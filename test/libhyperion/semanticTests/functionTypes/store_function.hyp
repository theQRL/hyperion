contract Other {
    function addTwo(uint256 x) public returns (uint256) {
        return x + 2;
    }
}


contract C {
    function (function (uint256) external returns (uint256)) internal returns (uint256) ev;
    function (uint256) external returns (uint256) x;

    function store(function(uint256) external returns (uint256) y) public {
        x = y;
    }

    function eval(function(uint256) external returns (uint256) y) public returns (uint256) {
        return y(7);
    }

    function t() public returns (uint256) {
        ev = eval;
        this.store((new Other()).addTwo);
        return ev(x);
    }
}
