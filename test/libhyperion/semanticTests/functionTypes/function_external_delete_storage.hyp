contract C {
    function() external public x;
    uint public y = 0;

    function increment() public {
        ++y;
    }

    function set() external {
        x = this.increment;
    }

    function incrementIndirectly() public {
        x();
    }

    function deleteFunction() public {
        // used to lead to an ICE during IR
        delete x;
    }
}
// ====
// QRVMVersion: >=zond
// ----
// x() -> 0, 0
// y() -> 0
// increment() ->
// y() -> 1
// set() ->
// x() -> 0x719edbf47d4c270f39cfc6b3e97e7312b5fc1a4a769bfdc4544ce960f9df9199a578cc81f56f49da5d91e3a6a4a1c67f7043cd900897ae0f8a446150858fbcff, 0xd09de08a
// increment() ->
// y() -> 2
// incrementIndirectly() ->
// y() -> 3
// deleteFunction() ->
// increment() ->
// y() -> 4
// incrementIndirectly() -> FAILURE
// y() -> 4
