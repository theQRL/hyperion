library Utils {
    function reduce(
        uint256[] memory array,
        function(uint, uint) internal returns (uint) f,
        uint init
    ) internal returns (uint) {
        for (uint256 i = 0; i < array.length; i++) {
            init = f(array[i], init);
        }
        return init;
    }

    function sum(uint a, uint b) internal returns (uint) {
        return a + b;
    }
}


contract C {
    function f(uint256[] memory x) public returns (uint) {
        return Utils.reduce(x, Utils.sum, 0);
    }
}
// ----
// f(uint256[]): 0x20, 0x3, 0x1, 0x7, 0x3 -> FAILURE, hex"4e487b71", 0x41
