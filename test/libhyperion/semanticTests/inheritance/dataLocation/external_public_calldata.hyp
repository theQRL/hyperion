abstract contract A {
    function f(uint[] calldata a) external virtual returns (uint[] calldata);
}

contract B is A {
    function f(uint[] memory a) public override returns (uint[] memory) {
        return a;
    }

    function g(uint[] calldata x) public returns (uint[] memory) {
        return f(x);
    }
}
