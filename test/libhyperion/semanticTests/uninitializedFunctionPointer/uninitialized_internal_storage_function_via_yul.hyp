contract Test {
	function() internal x;
	function f() public returns (bool) {
		function() internal t = x;
		// The legacy codegen  would use a specific function
		// entry tag that always panics.
		// Via Yul, the internal dispatch will panic instead.
		uint z;
		assembly { z := t }
		assert(z == 0);
		return true;
	}
}
// ====
// compileViaYul: true
// compileViaYulReason: Internal function pointer representations differ: legacy uses a panic stub, IR uses a zero dispatch ID.
// ----
// f() -> true
