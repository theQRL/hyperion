contract Child {
    uint public value;
    constructor() payable { value = msg.value; }
}

contract C {
    constructor() payable {}
    receive() external payable {}

    function echo() external payable returns (uint) { return msg.value; }
    function readBalance() external view returns (uint) { return address(this).balance; }

    function typedNarrow(uint x) public returns (uint) {
        return this.echo{value: uint256(x), gas: uint256((uint(1) << 256) + 100000)}();
    }
    function lowNarrow(uint x) public returns (bool ok) {
        (ok,) = address(this).call{value: uint256(x)}("");
    }
    function gasWord(uint gasLimit) public returns (uint) {
        return this.echo{gas: gasLimit}();
    }
    function gasNarrow(uint gasLimit) public returns (bool ok) {
        (ok,) = address(this).call{gas: uint256(gasLimit)}(abi.encodeCall(this.echo, ()));
    }
    function staticGas(uint gasLimit) public view returns (bool, uint) {
        (bool ok, bytes memory data) = address(this).staticcall{gas: gasLimit}(abi.encodeCall(this.readBalance, ()));
        return (ok, abi.decode(data, (uint)));
    }
    function delegateGas(uint gasLimit) public returns (bool, uint) {
        (bool ok, bytes memory data) = address(this).delegatecall{gas: gasLimit}(abi.encodeCall(this.readBalance, ()));
        return (ok, abi.decode(data, (uint)));
    }
    function wrappedValue() public returns (uint) {
        uint256 value = type(uint256).max;
        unchecked { value += 1; }
        return this.echo{value: value}();
    }
    function wrappedGas() public returns (bool ok) {
        uint256 gasLimit = type(uint256).max;
        unchecked { gasLimit += 1; }
        (ok,) = address(this).call{gas: gasLimit}(abi.encodeCall(this.echo, ()));
    }
    function createNarrow(uint x, bool salted) public returns (uint) {
        Child child;
        if (salted)
            child = new Child{value: uint256(x), salt: bytes64(uint(1))}();
        else
            child = new Child{value: uint256(x)}();
        return child.value();
    }
}
