// This tests skipping the extcodesize check.

contract T {
    constructor() { this.f(); }
    function f() external {}
}
contract U {
    constructor() { this.f(); }
    function f() external returns (uint) {}
}

contract C {
    function f(uint c) external returns (uint) {
        if (c == 0) new T();
        else if (c == 1) new U();
        return 1 + c;
    }
}
// ----
// f(uint512): 0 -> FAILURE
// f(uint512): 1 -> FAILURE
// f(uint512): 2 -> 3
