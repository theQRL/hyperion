contract C {
    function minValue() public pure returns (int) { return type(int).min; }
    function maxValue() public pure returns (int) { return type(int).max; }
    function roundtrip(int x) public pure returns (int) { return x; }
    function negate(int x) public pure returns (int) { return -x; }
    function straddleBit256(int x) public pure returns (int) { return x * 2; }
    function explicitWidth(int512 x) public pure returns (int512) { return x - 1; }
    function signExtendsAboveBit256(int256 x) public pure returns (int) { return x; }
}
