contract C {
    function maxValue() public pure returns (uint) { return type(uint).max; }
    function roundtrip(uint x) public pure returns (uint) { return x; }
    function highBitSet() public pure returns (uint) { return uint(1) << 511; }
    function aboveUint256Max() public pure returns (uint) { return uint(type(uint256).max) + 1; }
    function straddleBit256(uint x) public pure returns (uint) { return x * 2; }
    function explicitWidth(uint512 x) public pure returns (uint512) { return x + 1; }
    function narrowsToUint256(uint x) public pure returns (uint256) { return uint256(x); }
}
