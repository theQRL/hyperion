contract C {
    uint256[2] public values = [11, 22];

    function storageIndex(uint index) external view returns (uint256) {
        return values[index];
    }
    function memoryIndex(uint index) external pure returns (uint256) {
        uint256[] memory a = new uint256[](2);
        a[0] = 11;
        a[1] = 22;
        return a[index];
    }
    function calldataIndex(uint256[2] calldata a, uint index) external pure returns (uint256) {
        return a[index];
    }
    function bytesIndex(uint index) external pure returns (bytes1) {
        return bytes2(0x1234)[index];
    }
    function arrayLength(uint length) external pure returns (uint256) {
        return (new uint256[](length)).length;
    }
    function bytesLength(uint512 length) external pure returns (uint256) {
        return (new bytes(length)).length;
    }
    function sliceLength(bytes calldata a, uint start, uint end) external pure returns (uint256) {
        bytes calldata slice = a[start:end];
        return slice.length;
    }
    function sliceIndex(bytes calldata a, uint index) external pure returns (bytes1) {
        return a[1:][index];
    }
}
