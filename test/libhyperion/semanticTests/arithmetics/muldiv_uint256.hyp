// Keep the mulDiv implementation in sync with the assembly porting guide.
contract Math256 {
    function mulDiv(uint256 a, uint256 b, uint256 denominator)
        public pure returns (uint256)
    {
        require(denominator != 0, "Division by zero");

        uint product = uint(a) * uint(b);
        uint result = product / uint(denominator);

        require(result <= type(uint256).max, "Result exceeds uint256");
        return uint256(result);
    }

    // Internal calls must also handle locals with dirty upper bits after narrowing.
    function fromNarrowed(uint a, uint b, uint denominator) external pure returns (uint256) {
        return mulDiv(uint256(a), uint256(b), uint256(denominator));
    }
}
