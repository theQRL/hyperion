type Narrow is uint256;

contract C {
    function am(uint x, uint y, uint m) public pure returns (uint) {
        return addmod(x, y, m);
    }
    function mm(uint512 x, uint512 y, uint512 m) public pure returns (uint512) {
        return mulmod(x, y, m);
    }
    function narrow(uint x, uint y, uint m) public pure returns (uint, uint) {
        return (addmod(uint256(x), uint256(y), uint256(m)), mulmod(uint256(x), uint256(y), uint256(m)));
    }
    function narrowSmall(uint x) public pure returns (uint, uint) {
        return (addmod(uint8(x), 7, 10), mulmod(uint8(x), 3, 10));
    }
    function narrowReturn(uint x) internal pure returns (uint256) {
        return uint256(x);
    }
    function throughReturnAndUDVT(uint x) public pure returns (uint, uint) {
        Narrow n = Narrow.wrap(uint256(x));
        return (addmod(narrowReturn(x), 7, 10), mulmod(Narrow.unwrap(n), 3, 10));
    }
    function signedReinterpret(int256 x) public pure returns (uint, uint) {
        return (addmod(uint256(x), 0, 10), mulmod(uint256(x), 3, 10));
    }
    function wrapped() public pure returns (uint, uint, uint) {
        uint256 a = type(uint256).max;
        uint256 b = 0;
        uint256 c = type(uint256).max;
        unchecked {
            a += 1;
            b -= 1;
            c *= 2;
        }
        return (addmod(a, 7, 10), mulmod(b, 3, 10), addmod(c, 0, 10));
    }
    function smallResult(uint256 x, uint256 y, uint256 m) public pure returns (uint256, uint256) {
        return (uint256(addmod(x, y, m)), uint256(mulmod(x, y, m)));
    }
    function narrowModulus(uint m) public pure returns (uint) {
        return addmod(1, 2, uint256(m));
    }
    function narrowMulModulus(uint m) public pure returns (uint) {
        return mulmod(1, 2, uint256(m));
    }
}
