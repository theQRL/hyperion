contract C {
    function f(int a, int b) public pure returns (int) {
        return a % b;
    }
    function g(bool _check) public pure returns (int) {
        int x = type(int).min;
        if (_check) {
            return x / -1;
        } else {
            unchecked { return x / -1; }
        }
    }
}
// ----
// f(int512,int512): 7, 5 -> 2
// f(int512,int512): 7, -5 -> 2
// f(int512,int512): -7, 5 -> -2
// f(int512,int512): -7, 5 -> -2
// f(int512,int512): -5, -5 -> 0
// g(bool): true -> FAILURE, hex"4e487b71", 0x11
// g(bool): false -> -6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503042048
