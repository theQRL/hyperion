// Exercise constant folding and runtime opcodes in both pipelines and optimizer modes.
contract C {
    function constants() external pure returns (uint a, uint b, uint c, uint d, uint e, uint f) {
        assembly {
            a := signextend(31, shl(255, 1))
            b := signextend(63, shl(511, 1))
            c := byte(32, shl(248, 0xab))
            d := byte(63, 0xcd)
            e := exp(2, 511)
            f := exp(2, 512)
        }
    }
    function runtime(uint x, uint n) external pure returns (uint a, uint b, uint c) {
        assembly {
            a := signextend(n, x)
            b := byte(n, x)
            c := exp(x, n)
        }
    }
    function wordMaximum() external pure returns (uint r) {
        assembly { r := not(0) }
    }
    function multiply(uint a, uint b) external pure returns (uint product, uint low256) {
        assembly {
            product := mul(a, b)
            low256 := and(product, sub(shl(256, 1), 1))
        }
    }
}
