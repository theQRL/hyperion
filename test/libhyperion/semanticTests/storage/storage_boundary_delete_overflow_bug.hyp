contract C {
    // 256 uint256 values, packed two per 64-byte slot, occupy 128 slots. Starting the
    // array at type(uint512).max - 99 puts the first 100 slots below 2**512; the
    // remaining 28 wrap around to slots 0..27.
    function getSlot() internal pure returns (uint512 slot) {
        slot = type(uint512).max - 99;
        // The 128 slots of the array straddle the end of the slot space.
        assert(type(uint512).max - slot + 1 < 128);
    }

    function getArray() internal pure returns (uint256[256][1] storage _x) {
        uint512 s = getSlot();
        assembly {
            _x.slot := s
        }
    }

    function fillArray() public {
        uint256[256][1] storage _x = getArray();
        for (uint256 i = 1; i < 256; i++)
            _x[0][i] = i;
    }

    function partialAssignArray() public {
        uint256[256][1] storage _x = getArray();
        _x[0] = [11, 22, 33, 44, 55, 66, 77, 88, 99];
    }

    function clearArray() public {
        uint256[256][1] storage _x = getArray();
        delete _x[0];
    }

    // Element 5 lives below the boundary (slot type(uint512).max - 97),
    // element 200 lives past it (slot 0).
    function get(uint256 i) public view returns (uint256) {
        return getArray()[0][i];
    }

    function x() public view returns (uint256[256] memory) {
        return getArray()[0];
    }
}
