contract C {
    function getArray() internal pure returns (uint128[40][1] storage _x) {
        // 4 uint128 per 64-byte slot -> 10 slots starting at 2**512 - 5,
        // wrapping past the last slot to slots 0..4.
        assembly {
            _x.slot := sub(0, 5)
        }
    }

    function fillArray() public {
        uint128[40][1] storage _x = getArray();
        for (uint128 i = 1; i < 40; i++)
            _x[0][i] = i;
    }

    function clearArray() public {
        uint128[40][1] storage _x = getArray();
        delete _x[0];
    }

    function x() public view returns (uint128[40] memory) {
        return getArray()[0];
    }
}
