contract C {
    bytes16[9] _x; // 4 per slot
    bytes33[10] _y; // 1 per slot, no offset counter

    constructor() {
        for (uint i = 0; i < _x.length; ++i) _x[i] = bytes16(uint128(i));
        _y[8] = _y[9] = bytes16(uint128(2));
    }

    function getXAsUint() public view returns (uint128[9] memory result) {
        for (uint i = 0; i < 9; i++) {
            result[i] = uint128(_x[i]);
        }
    }

    function getYAsUint() public view returns (uint128[10] memory result) {
        for (uint i = 0; i < 10; i++) {
            result[i] = uint128(bytes16(_y[i]));
        }
    }

    function copy() public {
        _y = _x;
    }
}
// ----
// getXAsUint() -> 0, 1, 2, 3, 4, 5, 6, 7, 8
// getYAsUint() -> 0, 0, 0, 0, 0, 0, 0, 0, 2, 2
// copy()
// gas irOptimized: 190963
// gas legacy: 195042
// gas legacyOptimized: 191114
// getXAsUint() -> 0, 1, 2, 3, 4, 5, 6, 7, 8
// getYAsUint() -> 0, 1, 2, 3, 4, 5, 6, 7, 8, 0
