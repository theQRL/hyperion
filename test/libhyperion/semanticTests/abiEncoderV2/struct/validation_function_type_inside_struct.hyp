pragma abicoder               v2;

contract C {
    struct S { function () external x; }
    function f(S memory) public pure returns (uint r) { r = 1; }
    function g(S calldata) external pure returns (uint r) { r = 2; }
    function h(S calldata s) external pure returns (uint r) { s.x; r = 3; }
}
// ====
// QRVMVersion: >=zond
// ----
// f((function)): 0x1234, 0xffffffff -> 1
// f((function)): 0x1234, 0x100000000 -> 1
// g((function)): 0x1234, 0xffffffff -> 2
// g((function)): 0x1234, 0x100000000 -> 2
// h((function)): 0x1234, 0xffffffff -> 3
// h((function)): 0x1234, 0x100000000 -> 3
// f((function)): 0x1234 -> FAILURE
// g((function)): 0x1234 -> FAILURE
// h((function)): 0x1234 -> FAILURE
