contract C {
    function f(uint len) public pure returns (bytes memory) {
        uint[] memory a = new uint[](len);
        for (uint i = 0; i < len; i++)
            a[i] = i + 1;
        uint16[3] memory b = [uint16(0xaaaa), 0xbbbb, 0xcccc];
        // The elements of an array are copied as whole words.
        return abi.encodePacked(a, uint8(0x77), b);
    }
}
