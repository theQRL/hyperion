contract C {
    /// Fills the memory that the next allocations will get.
    function dirty() internal pure {
        assembly {
            let p := mload(0x80)
            for { let i := 0 } lt(i, 0x800) { i := add(i, 0x40) } { mstore(add(p, i), not(0)) }
        }
    }

    function make(uint len) internal pure returns (bytes memory b) {
        b = new bytes(len);
        for (uint i = 0; i < len; i++)
            b[i] = bytes1(uint8(i + 1));
    }

    // In all of these the byte array is copied to memory that holds other data.
    // What follows it in its last word has to be zero.

    function ret(uint len) public pure returns (bytes memory) {
        bytes memory b = make(len);
        dirty();
        return b;
    }

    function encode(uint len) public pure returns (bytes memory) {
        bytes memory b = make(len);
        dirty();
        return abi.encode(b, uint(7));
    }

    function decode(uint len) public pure returns (bytes memory, uint afterArray) {
        bytes memory payload = abi.encode(make(len));
        dirty();
        bytes memory decoded = abi.decode(payload, (bytes));
        // The copy does not write behind the last word of the array it fills.
        assembly { afterArray := mload(mload(0x80)) }
        return (decoded, afterArray);
    }

    // Here nothing follows the byte array but the next value.

    function packed(uint len) public pure returns (bytes memory) {
        bytes memory b = make(len);
        dirty();
        return abi.encodePacked(b, uint8(0x77), b);
    }

    function concat(uint len) public pure returns (string memory) {
        string memory s = string(make(len));
        dirty();
        return string.concat(s, "|", s);
    }

    function hash(uint len) public pure returns (bool) {
        bytes memory b = make(len);
        dirty();
        return keccak256(abi.encodePacked(b, b)) == keccak256(bytes.concat(b, b));
    }
}
