contract C {
    function f(int32 a, uint32 b) public returns (int32) {
        return a >> b;
    }
}
// ----
// f(int32,uint32): -103, 0x00 -> -103
// f(int32,uint32): -103, 0x01 -> -52
// f(int32,uint32): -103, 0x02 -> -26
// f(int32,uint32): -103, 0x04 -> -7
// f(int32,uint32): -103, 0x08 -> -1
