        return xmssverify(MESSAGE, signature, PK_SHA2_256);
    }
    function truncatedSignature() public returns (bool) {
        bytes memory signature = SIG_SHA2_256;
        assembly { mstore(signature, sub(mload(signature), 32)) }
        return xmssverify(MESSAGE, signature, PK_SHA2_256);
    }
    function wrongKeyLength() public returns (bool) {
        bytes memory pk = PK_SHA2_256;
        assembly { mstore(pk, 66) }
        return xmssverify(MESSAGE, SIG_SHA2_256, pk);
    }
    function multisigDescriptor() public returns (bool) {
        bytes memory pk = PK_SHA2_256;
        pk[0] = 0x10;
        return xmssverify(MESSAGE, SIG_SHA2_256, pk);
    }
    function reservedDescriptorByte() public returns (bool) {
        bytes memory pk = PK_SHA2_256;
        pk[2] = 0x01;
        return xmssverify(MESSAGE, SIG_SHA2_256, pk);
    }
    function emptyKey() public returns (bool) {
        return xmssverify(MESSAGE, SIG_SHA2_256, "");
    }
    function keyPassedInsideSignature() public returns (bool) {
        // Same bytes as the valid call, but the key is appended to the signature argument.
        return xmssverify(MESSAGE, bytes.concat(SIG_SHA2_256, PK_SHA2_256), "");
    }
    function keyBoundaryShiftedByOneByte() public returns (bool) {
        bytes memory pk = PK_SHA2_256;
        bytes memory signature = bytes.concat(SIG_SHA2_256, bytes1(pk[0]));
        bytes memory shortKey = new bytes(66);
        for (uint i = 0; i < 66; i++) shortKey[i] = pk[i + 1];
        return xmssverify(MESSAGE, signature, shortKey);
    }
    function keyWithLeadingExtraByte() public returns (bool) {
        return xmssverify(MESSAGE, SIG_SHA2_256, bytes.concat(bytes1(0), PK_SHA2_256));
    }
}
