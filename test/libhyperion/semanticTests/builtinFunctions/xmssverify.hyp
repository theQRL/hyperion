    function sha2_256() public returns (bool) {
        return xmssverify(MESSAGE, SIG_SHA2_256, PK_SHA2_256);
    }
    function shake128() public returns (bool) {
        return xmssverify(MESSAGE, SIG_SHAKE128, PK_SHAKE128);
    }
    function shake256() public returns (bool) {
        return xmssverify(MESSAGE, SIG_SHAKE256, PK_SHAKE256);
    }
    function lastIndex() public returns (bool) {
        return xmssverify(MESSAGE_LAST, SIG_SHAKE256_LAST, PK_SHAKE256);
    }
    function emptyMessage() public returns (bool) {
        return xmssverify("", SIG_SHAKE128_H6_EMPTY, PK_SHAKE128_H6);
    }
    function literalMessage() public pure returns (bool) {
        return xmssverify("The quick brown fox jumps over the lazy dog", SIG_SHA2_256, PK_SHA2_256);
    }
    function fromStorage() public returns (bool) {
        stored = SIG_SHA2_256;
        return xmssverify(MESSAGE, stored, PK_SHA2_256);
    }
    function fromCalldata(bytes calldata message, bytes calldata signature, bytes calldata pk) external returns (bool) {
        return xmssverify(message, signature, pk);
    }
    function wrongMessage() public returns (bool) {
        return xmssverify("The quick brown fox jumps over the lazy cat", SIG_SHA2_256, PK_SHA2_256);
    }
    function wrongKey() public returns (bool) {
        return xmssverify(MESSAGE, SIG_SHA2_256, PK_SHAKE128);
    }
    function corruptedSignature() public returns (bool) {
        bytes memory signature = SIG_SHA2_256;
        signature[40] ^= 0x01;
        return xmssverify(MESSAGE, signature, PK_SHA2_256);
    }
