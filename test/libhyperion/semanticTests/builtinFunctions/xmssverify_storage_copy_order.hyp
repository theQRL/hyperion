// Real vectors from xmssverify.hyp (theQRL/qrllib XmssFast, SHA2-256, tree height 4, leaf index 1).
contract C {
    bytes signature;

    function change(bytes memory pk) internal returns (bytes memory) {
        signature = hex"00";
        return pk;
    }

    function f(bytes memory m, bytes memory s, bytes memory pk) public returns (bool, bool, bool) {
        signature = s;
        bool beforeChange = xmssverify(m, signature, pk);
        // Copy the storage signature before the public key argument overwrites it.
        bool duringChange = xmssverify(m, signature, change(pk));
        assert(beforeChange == duringChange);
        return (beforeChange, duringChange, xmssverify(m, signature, pk));
    }

    function run(bool corrupt) public returns (bool, bool, bool) {
        bytes memory s = signatureFixture();
        if (corrupt)
            s[40] = bytes1(uint8(s[40]) ^ 1);
        return f("The quick brown fox jumps over the lazy dog", s, publicKeyFixture());
    }

