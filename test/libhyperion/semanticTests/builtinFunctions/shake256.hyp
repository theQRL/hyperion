contract C {
    function f() public returns (bytes64) {
        return shake256("abc");
    }

    function raw(uint256 length, uint256 suppliedGas) public view returns (bool, uint256) {
        (bool success, bytes memory output) = address(6).staticcall{gas: suppliedGas}(new bytes(length));
        return (success, output.length);
    }
}
