contract C {
    // Field sizes of the beacon chain DepositData container.
    uint constant PUBKEY_LENGTH = 2592;
    uint constant WITHDRAWAL_RECIPIENT_LENGTH = 64;
    uint constant AMOUNT_LENGTH = 8;
    uint constant RANDAO_COMMITMENT_LENGTH = 32;
    uint constant SIGNATURE_LENGTH = 4627;

    function pattern(uint length, uint8 offset) internal pure returns (bytes memory b) {
        b = new bytes(length);
        for (uint i = 0; i < length; i++)
            b[i] = bytes1(uint8(i + offset));
    }

    function zero() public returns (bytes32) {
        return depositroot(
            new bytes(PUBKEY_LENGTH),
            new bytes(WITHDRAWAL_RECIPIENT_LENGTH),
            new bytes(AMOUNT_LENGTH),
            new bytes(RANDAO_COMMITMENT_LENGTH),
            new bytes(SIGNATURE_LENGTH)
        );
    }

    function patterned() public returns (bytes32) {
        return depositroot(
            pattern(PUBKEY_LENGTH, 1),
            pattern(WITHDRAWAL_RECIPIENT_LENGTH, 2),
            pattern(AMOUNT_LENGTH, 3),
            pattern(RANDAO_COMMITMENT_LENGTH, 4),
            pattern(SIGNATURE_LENGTH, 5)
        );
    }

    function shortCommitment() public returns (bytes32) {
        return depositroot(
            pattern(PUBKEY_LENGTH, 1),
            pattern(WITHDRAWAL_RECIPIENT_LENGTH, 2),
            pattern(AMOUNT_LENGTH, 3),
            pattern(RANDAO_COMMITMENT_LENGTH - 1, 4),
            pattern(SIGNATURE_LENGTH, 5)
        );
    }

    // go-qrl reads the fields at fixed offsets of the concatenated input and pads the input with
    // zero bytes, so a short field shifts the ones after it instead of failing.
    function shortCommitmentShiftsTheSignature() public returns (bool) {
        bytes memory signature = pattern(SIGNATURE_LENGTH, 5);
        bytes memory commitment = bytes.concat(pattern(RANDAO_COMMITMENT_LENGTH - 1, 4), signature[0]);
        bytes memory shifted = new bytes(SIGNATURE_LENGTH);
        for (uint i = 0; i + 1 < SIGNATURE_LENGTH; i++)
            shifted[i] = signature[i + 1];
        return depositroot(
            pattern(PUBKEY_LENGTH, 1),
            pattern(WITHDRAWAL_RECIPIENT_LENGTH, 2),
            pattern(AMOUNT_LENGTH, 3),
            commitment,
            shifted
        ) == shortCommitment();
    }

    // Input past the last field is ignored.
    function longSignature() public returns (bool) {
        return depositroot(
            pattern(PUBKEY_LENGTH, 1),
            pattern(WITHDRAWAL_RECIPIENT_LENGTH, 2),
            pattern(AMOUNT_LENGTH, 3),
            pattern(RANDAO_COMMITMENT_LENGTH, 4),
            pattern(SIGNATURE_LENGTH + 10, 5)
        ) == patterned();
    }
}
