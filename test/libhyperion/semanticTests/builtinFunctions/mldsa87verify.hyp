    function signedContext(uint256 length) internal pure returns (bytes memory context) {
        context = new bytes(length);
        for (uint256 i = 0; i < length; ++i)
            context[i] = 0xa5;
    }

    function valid() public pure returns (bool) {
        return mldsa87verify(signedDigest(), signatureFixture(11), publicKeyFixture(), bytes("QNS-SIGN-v1"));
    }

    function invalid() public pure returns (bool) {
        return mldsa87verify(bytes64(0), new bytes(0), new bytes(0), new bytes(0));
    }

    function invalidSignature() public pure returns (bool) {
        bytes memory signature = signatureFixture(11);
        signature[0] = bytes1(uint8(signature[0]) ^ 1);
        return mldsa87verify(signedDigest(), signature, publicKeyFixture(), "QNS-SIGN-v1");
    }

    function corruptedKey() public pure returns (bool) {
        bytes memory publicKey = publicKeyFixture();
        publicKey[1000] = bytes1(uint8(publicKey[1000]) ^ 1);
        return mldsa87verify(signedDigest(), signatureFixture(11), publicKey, "QNS-SIGN-v1");
    }

    function corruptedSignature() public pure returns (bool) {
        bytes memory signature = signatureFixture(11);
        signature[4000] = bytes1(uint8(signature[4000]) ^ 1);
        return mldsa87verify(signedDigest(), signature, publicKeyFixture(), "QNS-SIGN-v1");
    }

    function corruptedDigestPrefix() public pure returns (bool) {
        return mldsa87verify(signedDigest() ^ bytes64(bytes1(0x01)), signatureFixture(11), publicKeyFixture(), "QNS-SIGN-v1");
    }

    function corruptedDigestSuffix() public pure returns (bool) {
        return mldsa87verify(signedDigest() ^ bytes64(uint512(1)), signatureFixture(11), publicKeyFixture(), "QNS-SIGN-v1");
    }

    function wrongContext() public pure returns (bool) {
        return mldsa87verify(signedDigest(), signatureFixture(11), publicKeyFixture(), "QNS-SIGN-v2");
    }

    function literalContext() public pure returns (bool) {
        return mldsa87verify(signedDigest(), signatureFixture(11), publicKeyFixture(), "QNS-SIGN-v1");
    }

    function verifyCalldata(
        bytes64 digest,
        bytes calldata signature,
        bytes calldata publicKey,
        bytes calldata context
    ) external pure returns (bool) {
        return mldsa87verify(digest, signature, publicKey, context);
    }

    function calldataArguments() public view returns (bool) {
        return this.verifyCalldata(signedDigest(), signatureFixture(11), publicKeyFixture(), "QNS-SIGN-v1");
    }

    // Exercise host framing directly, without the builtin's argument-length checks.
    function rawFrame(uint8 contextLength, bool trailingByte) public view returns (bool success, uint256 outputLength) {
        bytes memory frame = abi.encodePacked(
            signedDigest(), publicKeyFixture(), signatureFixture(11), bytes1(contextLength), "QNS-SIGN-v1"
        );
        if (trailingByte)
            frame = bytes.concat(frame, hex"00");
        bytes memory result;
        (success, result) = address(3).staticcall(frame);
        outputLength = result.length;
    }

    function emptyContext() public pure returns (bool) {
        return mldsa87verify(signedDigest(), signatureFixture(0), publicKeyFixture(), "");
    }

    function maxContext() public pure returns (bool) {
        return mldsa87verify(signedDigest(), signatureFixture(255), publicKeyFixture(), signedContext(255));
    }

    function oversizedContext() public pure returns (bool) {
        return mldsa87verify(signedDigest(), signatureFixture(255), publicKeyFixture(), signedContext(256));
    }

    function shortSignature() public pure returns (bool) {
        bytes memory signature = signatureFixture(11);
        assembly { mstore(signature, 4626) }
        return mldsa87verify(signedDigest(), signature, publicKeyFixture(), "QNS-SIGN-v1");
    }

    function longSignature() public pure returns (bool) {
        bytes memory signature = bytes.concat(signatureFixture(11), hex"00");
        return mldsa87verify(signedDigest(), signature, publicKeyFixture(), "QNS-SIGN-v1");
    }

    // Without both length checks this produces a valid frame: the leading signature
    // byte completes the shortened public key and the original signature follows it.
    function misalignedPublicKey() public pure returns (bool) {
        bytes memory publicKey = publicKeyFixture();
        bytes memory signature = bytes.concat(publicKey[2591], signatureFixture(11));
        assembly { mstore(publicKey, 2591) }
        return mldsa87verify(signedDigest(), signature, publicKey, "QNS-SIGN-v1");
    }

    function record(uint256 step) internal returns (uint256) {
        order = order * 10 + step;
        return step;
    }

    function argumentOrder() public returns (bool result, uint256) {
        result = mldsa87verify(
            bytes64(bytes32(record(1))),
            new bytes(record(2)),
            new bytes(record(3)),
            new bytes(record(4))
        );
        return (result, order);
    }

    // A precompile call that runs out of gas makes the builtin revert.
    function callVerifyCalldata(uint256 gasLimit) public view returns (bool success, bool result) {
        bytes memory data;
        (success, data) = address(this).staticcall{gas: gasLimit}(abi.encodeCall(
            this.verifyCalldata,
            (signedDigest(), signatureFixture(11), publicKeyFixture(), bytes("QNS-SIGN-v1"))
        ));
        if (success)
            result = abi.decode(data, (bool));
    }
}
