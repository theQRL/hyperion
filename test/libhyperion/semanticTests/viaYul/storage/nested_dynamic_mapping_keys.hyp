contract C {
    struct Buckets {
        mapping(string => uint) first;
        mapping(string => uint) second;
    }

    mapping(string => mapping(string => uint)) stringData;
    mapping(bytes => mapping(bytes => uint)) bytesData;
    mapping(string => Buckets) structData;
    mapping(string => mapping(string => uint)[2]) arrayData;

    function test_string() public returns (uint a, uint b, uint c) {
        stringData["outer-a"]["shared-inner"] = 11;
        stringData["outer-b"]["shared-inner"] = 22;
        a = stringData["outer-a"]["shared-inner"];
        b = stringData["outer-b"]["shared-inner"];
        c = stringData["missing"]["shared-inner"];
    }

    function test_bytes() public returns (uint a, uint b, uint c) {
        bytes memory outerA = hex"010203";
        bytes memory outerB = hex"040506";
        bytes memory inner = hex"abcdef";
        bytesData[outerA][inner] = 31;
        bytesData[outerB][inner] = 47;
        a = bytesData[outerA][inner];
        b = bytesData[outerB][inner];
        c = bytesData[hex"9999"][inner];
    }

    function test_struct_member_slot() public returns (uint a, uint b, uint c) {
        structData["outer"].first["shared-inner"] = 59;
        structData["outer"].second["shared-inner"] = 83;
        a = structData["outer"].first["shared-inner"];
        b = structData["outer"].second["shared-inner"];
        c = structData["other"].second["shared-inner"];
    }

    function test_fixed_array_index_slot() public returns (uint a, uint b, uint c) {
        arrayData["outer"][0]["shared-inner"] = 107;
        arrayData["outer"][1]["shared-inner"] = 131;
        a = arrayData["outer"][0]["shared-inner"];
        b = arrayData["outer"][1]["shared-inner"];
        c = arrayData["other"][1]["shared-inner"];
    }
}
// ====
