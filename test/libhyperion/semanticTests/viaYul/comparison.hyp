contract C {
    function f(address a) public pure returns (bool) {
        return a == address(0);
    }
    function g() public pure returns (bool) {
        return bytes3("abc") == bytes4("abc");
    }
    function lt(uint a, uint b) public pure returns (bool) {
        return a < b;
    }
    function slt(int a, int b) public pure returns (bool) {
        return a < b;
    }
    function lte(uint a, uint b) public pure returns (bool) {
        return a <= b;
    }
    function slte(int a, int b) public pure returns (bool) {
        return a <= b;
    }
    function gt(uint a, uint b) public pure returns (bool) {
        return a > b;
    }
    function sgt(int a, int b) public pure returns (bool) {
        return a > b;
    }
    function gte(uint a, uint b) public pure returns (bool) {
        return a >= b;
    }
    function sgte(int a, int b) public pure returns (bool) {
        return a >= b;
    }
    function eq(uint a, uint b) public pure returns (bool) {
        return a == b;
    }
    function neq(uint a, uint b) public pure returns (bool) {
        return a != b;
    }
}
// ----
// f(address): Q1234 -> false
// f(address): Q00 -> true
// g() -> true
// lt(uint512,uint512): 4, 5 -> true
// lt(uint512,uint512): 5, 5 -> false
// lt(uint512,uint512): 6, 5 -> false
// gt(uint512,uint512): 4, 5 -> false
// gt(uint512,uint512): 5, 5 -> false
// gt(uint512,uint512): 6, 5 -> true
// lte(uint512,uint512): 4, 5 -> true
// lte(uint512,uint512): 5, 5 -> true
// lte(uint512,uint512): 6, 5 -> false
// gte(uint512,uint512): 4, 5 -> false
// gte(uint512,uint512): 5, 5 -> true
// gte(uint512,uint512): 6, 5 -> true
// eq(uint512,uint512): 4, 5 -> false
// eq(uint512,uint512): 5, 5 -> true
// eq(uint512,uint512): 6, 5 -> false
// neq(uint512,uint512): 4, 5 -> true
// neq(uint512,uint512): 5, 5 -> false
// neq(uint512,uint512): 6, 5 -> true
// slt(int512,int512): -1, 0 -> true
// slt(int512,int512): 0, 0 -> false
// slt(int512,int512): 1, 0 -> false
// sgt(int512,int512): -1, 0 -> false
// sgt(int512,int512): 0, 0 -> false
// sgt(int512,int512): 1, 0 -> true
// slte(int512,int512): -1, 0 -> true
// slte(int512,int512): 0, 0 -> true
// slte(int512,int512): 1, 0 -> false
// sgte(int512,int512): -1, 0 -> false
// sgte(int512,int512): 0, 0 -> true
// sgte(int512,int512): 1, 0 -> true
