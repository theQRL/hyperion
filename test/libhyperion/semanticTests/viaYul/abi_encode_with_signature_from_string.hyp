contract C {
    function f() public pure {
        string memory x = "my_signature";
        bytes memory r1 = abi.encodeWithSignature("my_signature", 1);
        bytes memory r2 = abi.encodeWithSignature(x, 1);
        assert(r1.length == r2.length);
        for (uint i = 0; i < r1.length; i++)
            assert(r1[i] == r2[i]);
    }
}
