contract C {
    struct S { S[] s; uint[] a; }
    S st;
    // 100 array suffixes and chains of 100 accesses stay within the recursion limit.
    uint[][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][][] x;
    function f() public view returns (uint) {
        return st.s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].s[0].a.length;
    }
}
