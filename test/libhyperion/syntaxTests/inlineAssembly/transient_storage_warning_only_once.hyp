contract C {
    function f() public {
        assembly {
            tstore(0, 1)
        }
    }
    function g() public {
        assembly {
            tstore(0, 2)
        }
    }
}

contract D {
    function h() public {
        assembly {
            tstore(0, 3)
        }
    }
}
