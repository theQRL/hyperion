contract C {
    function f(bytes32 d, bytes64 w, bytes memory s) public pure returns (bool, bool, bool, bool, bool) {
        return (
            mldsa87verify(w, s, s, s),
            mldsa87verify(shake256(s), s, s, s),
            mldsa87verify(bytes64(d), s, s, s),
            mldsa87verify(hex"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f", s, s, s),
            mldsa87verify("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", s, s, s)
        );
    }
}
