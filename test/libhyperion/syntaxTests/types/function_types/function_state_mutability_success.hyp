contract Test
{
  uint y;
  function internalPureFunc(uint x) internal pure returns (uint) { return x; }
  function internalViewFunc(uint x) internal view returns (uint) { return x + y; }
  function internalMutableFunc(uint x) internal returns (uint) { y = x; return x; }

  function externalPureFunc(uint x) external pure returns (uint) { return x; }
  function externalViewFunc(uint x) external view returns (uint) { return x + y; }
  function externalPayableFunc(uint x) external payable returns (uint) { return x + y; }
  function externalMutableFunc(uint x) external returns (uint) { y = x; return x; }

  function funcTakesInternalPure(function(uint) internal pure returns(uint) a) internal pure returns (uint) { return a(4); }
  function funcTakesInternalView(function(uint) internal view returns(uint) a) internal view returns (uint) { return a(4); }
  function funcTakesInternalMutable(function(uint) internal returns(uint) a) internal returns (uint) { return a(4); }

  function funcTakesExternalPure(function(uint) external pure returns(uint) a) internal pure returns (uint) { return a(4); }
  function funcTakesExternalView(function(uint) external view returns(uint) a) internal view returns (uint) { return a(4); }
  function funcTakesExternalPayable(function(uint) external payable returns(uint) a) internal returns (uint) { return a(4); }
  function funcTakesExternalMutable(function(uint) external returns(uint) a) internal returns (uint) { return a(4); }

  function tests() internal
  {
    funcTakesInternalPure(internalPureFunc);

    funcTakesInternalView(internalPureFunc);
    funcTakesInternalView(internalViewFunc);

    funcTakesInternalMutable(internalPureFunc);
    funcTakesInternalMutable(internalViewFunc);
    funcTakesInternalMutable(internalMutableFunc);

    funcTakesExternalPure(this.externalPureFunc);

    funcTakesExternalView(this.externalPureFunc);
    funcTakesExternalView(this.externalViewFunc);

    funcTakesExternalPayable(this.externalPayableFunc);

    funcTakesExternalMutable(this.externalPureFunc);
    funcTakesExternalMutable(this.externalViewFunc);
    funcTakesExternalMutable(this.externalPayableFunc);
    funcTakesExternalMutable(this.externalMutableFunc);
  }
}
