contract C {
    function narrowResult(uint x, uint y, uint m) public pure {
        uint256 a = addmod(x, y, m);
        uint256 b = mulmod(x, y, m);
    }
    function signedArgument(int512 x) public pure returns (uint) {
        return addmod(x, 1, 2);
    }
    function oversizedArgument() public pure returns (uint) {
        return mulmod(2**512, 1, 2);
    }
}
