contract C {
    function f(uint8 n, bool c) public payable returns (uint512 r) {
        uint512 bitmap;
        bitmap |= 1 << n;
        bitmap = bitmap | 1 << n;
        r = msg.value + (1 << n);
        bool big = msg.value >= 2 ** n;
        uint512 b = address(this).balance - (2 ** n);
        uint512 d = c ? 1 << n : 0;
        uint512 e = c ? msg.value : (2 ** n);
        uint512 g = (2 ** n);
        int512 s = 1;
        s = s + (-2) ** n;
        payable(msg.sender).transfer(2 ** n);
        bool sent = payable(msg.sender).send(1 << n);
        (bool ok, ) = msg.sender.call{value: 2 ** n, gas: 1 << n}("");
        // No warning: the operation is not widened, the base is converted, or the literal-base
        // result is a shift amount.
        uint256 narrow;
        narrow += 1 << n;
        narrow = narrow + (1 << n);
        bitmap = msg.value + (uint512(1) << n);
        bitmap <<= 1 << n;
        bitmap = bitmap << (1 << n);
        bitmap = (c ? 1 << n : 0) + 1;
        big; b; d; e; g; sent; ok;
    }
}

