contract C {
    function f(uint y) public pure {
        // one byte too long for storing in Fixedbytes (would require 65 bytes)
        y = 0xffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff000000001;
    }
}
