contract C {
    uint512 s = 2 ** 0x100;

    function g(uint512) internal pure {}

    function f(uint8 n) public pure returns (uint512 r) {
        uint512 a = 2 ** n;
        uint512 b = 1 << n;
        r = 3 ** n;
        g(2 ** n);
        // No warning: the base is converted, the target is not wider, the whole expression is a literal,
        // no bits can be lost, or warning 3149 already applies.
        uint512 c = uint512(2) ** n;
        uint256 d = 2 ** n;
        uint512 e = 2 ** 300;
        uint512 h = 2 >> n;
        uint512 i = 1 ** n;
        uint512 j = 0 << n;
        uint512 k = 2 ** uint512(n);
        a; b; c; d; e; h; i; j; k;
        return 2 ** n;
    }
}
